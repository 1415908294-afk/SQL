{
  "name": "sql-growth-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-metadata.mjs && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "data": "node scripts/generate-data.mjs",
    "verify": "node scripts/build-metadata.mjs && node scripts/verify.mjs && node scripts/verify-wasm.mjs && node scripts/verify-tutor.mjs",
    "postinstall": "node scripts/copy-assets.mjs && node scripts/build-metadata.mjs && node scripts/generate-data.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.30.0",
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.52.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "^0.468.0",
    "sql-formatter": "^15.6.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "@duckdb/node-api": "1.3.2-alpha.26"
  }
}
